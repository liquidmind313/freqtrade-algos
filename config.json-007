{
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "amend_last_stake_amount": true,
    "fiat_display_currency": "USD",
    "timeframe": "5m",
    "dry_run": false,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "buy": 10,
        "sell": 30,
        "unit": "seconds"
    },
    "order_types": {
        "buy": "market",
        "sell": "market",
        "forcesell": "market",
        "forcebuy": "market",
        "emergencysell": "market",
        "trailing_stop_loss": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false,
        "stoploss_on_exchange_interval": 60 
    },
    "bid_strategy": {
        "price_side": "ask",
        "ask_last_balance": 0.0,
        "use_order_book": false,
        "order_book_top": 1,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1

        }
    },
    "ask_strategy": {
        "price_side": "bid",
        "use_order_book": false,
        "order_book_top": 1,
        "order_book_max": 1  
    },
    "exchange": {
        "name": "kucoin",
        "key": " ",
        "secret": "  ",
        "password": " 32 passphrase ",
        "ccxt_config": {
            "enableRateLimit": false,
            "timeout": 60000,
            "urls": {
                "api": {
                    "public": "http://127.0.0.1:8080/kucoin",
                    "private": "http://127.0.0.1:8080/kucoin"
                }
            }
        },
        "ccxt_async_config": {
            "enableRateLimit": false,
            "timeout": 60000
        },
        "pair_whitelist": [
        ],
       "pair_blacklist": [
            // leveraged stuff / better not too touch without a StaticPairList method
            ".*(3|3L|3S)/.*",
            // fiat shit
            "(AUD|EUR|GBP|CHF|CAD|JPY)/.*",
            // stable coins
            "(BUSD|USDT|TUSD|USDC|CUSDT|DAI|USDN)/.*",
            // shit (fan) Tokens
            "(ACM|AFA|ALA|ALL|APL|ASR|ATM|BAR|CAI|CITY|FOR|GAL|GOZ|IBFK|JUV|LEG|LOCK-1|NAVI|NMR|NOV|OG|PFL|PSG|ROUSH|STV|TH|TRA|UCH|UFC|YBO)/.*",
            // some shits
            "(SLP|XVS|MEM|AMPL|XYM|POLX|CARR|SKEY|MASK|KLV|TLOS|JAR|BTCST|SUPER|LAYER|CTSI|MKR|HYDRA|DEGO)/.*",
            // other bs
            "(LPT|LRC|LTX|MIR|STMX|SXP|ZEC|VELO|SUN|CIRUS|REVV|XSR|VSYS|CBC|SCLP|ANKR)/.*",
            // shitty performance in most of the strategies
            "(TLOS|KEEP|AVA|NKN|MLN|AAVE|LAYER|SUKU|TKY|AOA|SUTER|TCP|INTER|HTR|SOLVE|CIX100|ETHO|ZCX|DINO|MXW|DAPPT|ONT|XDC|XDB|GENS|EOS)/.*",
            "(STX|POLK|CHR|XYO|VEGA|KRL|VIDT|HAI|OXT|AI|NORD|EDG|JAR|BTCST|XSR|CGG|VSYS|CBC|SCLP|FEAR|GMEE|FORESTPLUS|TARA|LOCG|SWASH|CGG|HTR|XNL|SENSO)/.",
              ]
    },
    protections = [
             {
                 "method": "StoplossGuard",
                 "lookback_period_candles": 13,
                 "trade_limit": 1,
                 "stop_duration_candles": 6,
                 "only_per_pair": False
             },
        {
            "method": "LowProfitPairs",
            "lookback_period_candles": 60,
            "trade_limit": 1,
            "stop_duration": 60,
            "required_profit": -0.05
        },
        {
            "method": "MaxDrawdown",
            "lookback_period_candles": 24,
            "trade_limit": 1,
            "stop_duration_candles": 12,
            "max_allowed_drawdown": 0.14
        },
    ],
    "pairlists": [
         {
                        "method": "VolumePairList",
                        "number_assets": 130,
                        "sort_key": "quoteVolume",
                        "refresh_period": 7200,
                        "lookback_timeframe": "30m",
                        "lookback_period": 96
              },
              {"method": "AgeFilter", "min_days_listed": 20},
              {"method": "SpreadFilter", "max_spread_ratio": 0.006},
              {
                        "method": "PriceFilter",
                        "min_price": 0.001
              },
              { 
                        "method": "RangeStabilityFilter",
                        "lookback_days": 3,
                        "min_rate_of_change": 0.05,
                        "refresh_period": 300
             },
             { 
                        "method": "VolatilityFilter",
                        "lookback_days": 3,
                        "min_volatility": 0.02,
                        "max_volatility": 0.75,
                        "refresh_period": 300
              },
        {"method": "ShuffleFilter"},
        {"method": "PerformanceFilter"},
        {
            "method": "VolumePairList",
                         "number_assets": 70,
                         "sort_key": "quoteVolume",
                         "refresh_period": 300,
        }
    ],
    "edge": {
        "enabled": false,
        "process_throttle_secs": 3600,
        "calculate_since_number_of_days": 7,
        "allowed_risk": 0.01,
        "stoploss_range_min": -0.01,
        "stoploss_range_max": -0.1,
        "stoploss_range_step": -0.01,
        "minimum_winrate": 0.60,
        "minimum_expectancy": 0.20,
        "min_trade_number": 10,
        "max_trade_duration_minute": 1440,
        "remove_pumps": false
    },
    "telegram": {
        "enabled": true,
        "token": "  ",
        "chat_id": " ",
"keyboard": [
            ["/profit","/balance","/status table","/daily"],
            ["/performance","/logs","/show_config","/trades"],
            ["/reload_config","/help","/start","/stop"]
        ],
        "notification_settings": {
            "status": "silent",
            "warning": "silent",
            "startup": "silent",
            "buy": "off",
            "sell": "off",
            "buy_cancel": "silent",
            "sell_cancel": "silent",
            "buy_fill": "silent",
            "sell_fill": "silent"
        },
        "balance_dust_level": 0.01
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": " ",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": ""
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "forcebuy_enable": true,
    "internals": {
    "process_throttle_secs": 5
    }
}
